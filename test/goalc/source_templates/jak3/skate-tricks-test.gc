;;-*-Lisp-*-
(in-package goal)

;; (AI-assisted) Production lifecycle/scoring/visual transforms without geometry.
(defun skate-test-trick-basic-lifecycle ()
  (skate-trick-reset! *skate-tricks*)
  (let ((passed (and (= (-> *skate-tricks* phase) 'ground)
                     (not (skate-trick-launch! *skate-tricks* 'unknown 0.5))
                     (= (-> *skate-tricks* phase) 'ground)
                     (skate-trick-launch! *skate-tricks* 'ollie 2.0))))
    (set! passed (and passed (= (-> *skate-tricks* phase) 'airborne)
                     (= (-> *skate-tricks* charge) 1.0)
                     (not (skate-trick-launch! *skate-tricks* 'kickflip 0.5))
                     (= (skate-trick-land! *skate-tricks* 2.0 0.0) 'clean)
                     (= (-> *skate-tricks* combo-points) 50.0)
                     (= (-> *skate-tricks* combo-count) 1)))
    ;; Repeated collision contacts cannot repeatedly award the same trick.
    (skate-trick-land! *skate-tricks* 2.0 0.0)
    (and passed (= (-> *skate-tricks* combo-points) 50.0)
         (= (-> *skate-tricks* combo-count) 1))))

(defun skate-test-trick-flips-and-failed-landing ()
  (skate-trick-reset! *skate-tricks*)
  (skate-trick-launch! *skate-tricks* 'kickflip 0.5)
  (skate-trick-air-step! *skate-tricks* 0.24 0.0 #f)
  (let ((passed (and (not (skate-trick-complete? *skate-tricks*))
                     (< (fabs (+ (skate-trick-board-roll *skate-tricks*) 32768.0)) 0.01)
                     (= (skate-trick-board-yaw *skate-tricks*) 0.0)
                     (= (skate-trick-land! *skate-tricks* 2.0 0.0) 'bail)
                     (= (-> *skate-tricks* combo-count) 0)
                     (not (skate-trick-launch! *skate-tricks* 'ollie 0.5)))))
    (skate-trick-recover! *skate-tricks*)
    (skate-trick-launch! *skate-tricks* 'varial-heelflip 0.5)
    (skate-trick-air-step! *skate-tricks* 0.7 0.0 #f)
    (and passed (skate-trick-complete? *skate-tricks*)
         (> (skate-trick-board-roll *skate-tricks*) 60000.0)
         (> (skate-trick-board-yaw *skate-tricks*) 30000.0)
         (= (skate-trick-land! *skate-tricks* 2.0 0.0) 'clean)
         (= (-> *skate-tricks* combo-points) 300.0)
         (= (skate-trick-board-roll *skate-tricks*) 0.0))))

(defun skate-test-trick-landing-quality ()
  (skate-trick-reset! *skate-tricks*)
  (skate-trick-launch! *skate-tricks* 'ollie 0.5)
  (let ((passed (= (skate-trick-land! *skate-tricks* 10.0 0.0) 'sketchy)))
    (set! passed (and passed (= (-> *skate-tricks* combo-points) 25.0)))
    (skate-trick-launch! *skate-tricks* 'nollie 0.5)
    (set! passed (and passed (= (skate-trick-land! *skate-tricks* 2.0 40.0) 'sketchy)))
    (skate-trick-launch! *skate-tricks* 'ollie 0.5)
    (set! passed (and passed (= (skate-trick-land! *skate-tricks* 17.0 0.0) 'bail)
                     (= (-> *skate-tricks* combo-points) 0.0)))
    (skate-trick-recover! *skate-tricks*)
    (skate-trick-launch! *skate-tricks* 'ollie 0.5)
    (and passed (= (skate-trick-land! *skate-tricks* 2.0 60.0) 'bail))))

(defun skate-test-trick-support-links-and-banking ()
  (skate-trick-reset! *skate-tricks*)
  (skate-trick-launch! *skate-tricks* 'ollie 0.5)
  (skate-trick-land! *skate-tricks* 2.0 0.0)
  (skate-trick-support! *skate-tricks* 'manual 0.25)
  (skate-trick-support! *skate-tricks* 'grind 0.25)
  (skate-trick-support! *skate-tricks* 'ground 0.0)
  (let ((passed (and (= (-> *skate-tricks* combo-count) 3)
                     (= (-> *skate-tricks* multiplier) 3)
                     (= (-> *skate-tricks* combo-points) 120.0))))
    (skate-trick-support! *skate-tricks* 'ground 1.0)
    (set! passed (and passed (= (-> *skate-tricks* banked-points) 0.0)))
    (skate-trick-support! *skate-tricks* 'ground 0.5)
    (set! passed (and passed (= (-> *skate-tricks* banked-points) 360.0)
                     (= (-> *skate-tricks* combo-count) 0)
                     (= (-> *skate-tricks* multiplier) 1)))
    (skate-trick-launch! *skate-tricks* 'ollie 0.5)
    (skate-trick-land! *skate-tricks* 2.0 0.0)
    (skate-trick-launch! *skate-tricks* 'ollie 0.5)
    (skate-trick-land! *skate-tricks* 2.0 0.0)
    (set! passed (and passed (= (-> *skate-tricks* combo-points) 75.0)))
    (skate-trick-bail! *skate-tricks*)
    (skate-trick-support! *skate-tricks* 'grind 2.0)
    (skate-trick-recover! *skate-tricks*)
    (and passed (= (-> *skate-tricks* banked-points) 360.0)
         (= (-> *skate-tricks* combo-points) 0.0)
         (= (-> *skate-tricks* phase) 'ground))))

(defun skate-test-trick-short-support-and-air-contact ()
  (skate-trick-reset! *skate-tricks*)
  (skate-trick-support! *skate-tricks* 'nose-manual 0.1)
  (skate-trick-support! *skate-tricks* 'ground 0.0)
  (let ((passed (= (-> *skate-tricks* combo-count) 0)))
    (skate-trick-launch! *skate-tricks* 'kickflip 0.5)
    (skate-trick-support! *skate-tricks* 'slide 2.0)
    (and passed (= (-> *skate-tricks* phase) 'airborne)
         (= (-> *skate-tricks* support-time) 0.0)
         (= (-> *skate-tricks* combo-count) 0))))

(defun skate-test-trick-late-and-grab ()
  (skate-trick-reset! *skate-tricks*)
  (skate-trick-launch! *skate-tricks* 'ollie 0.5)
  (skate-trick-air-step! *skate-tricks* 0.1 0.0 #f)
  (let ((passed (not (skate-trick-late! *skate-tricks* 'kickflip))))
    (skate-trick-air-step! *skate-tricks* 0.1 0.0 #f)
    (set! passed (and passed (skate-trick-late! *skate-tricks* 'kickflip)
                     (not (skate-trick-late! *skate-tricks* 'heelflip))
                     (not (skate-trick-complete? *skate-tricks*))))
    (skate-trick-air-step! *skate-tricks* 0.5 360.0 #t)
    (and passed (= (skate-trick-land! *skate-tricks* 2.0 0.0) 'clean)
         (= (-> *skate-tricks* combo-count) 3)
         (= (-> *skate-tricks* combo-points) 512.5)
         (not (skate-trick-late! *skate-tricks* 'heelflip)))))

(defun skate-test-trick-at-frame-rate ((fps int))
  (skate-trick-reset! *skate-tricks*)
  (skate-trick-launch! *skate-tricks* 'kickflip 0.5)
  (let ((dt (/ 1.0 (the float fps))))
    (dotimes (frame fps)
      (skate-trick-air-step! *skate-tricks* dt (* 360.0 dt) #t)))
  (and (= (skate-trick-land! *skate-tricks* 2.0 0.0) 'clean)
       (= (-> *skate-tricks* combo-points) 425.0)
       (= (-> *skate-tricks* combo-count) 2)))

(defun skate-test-trick-unprompted-fall ()
  (skate-trick-reset! *skate-tricks*)
  (let ((passed (skate-trick-fall! *skate-tricks*)))
    (skate-trick-air-step! *skate-tricks* 0.3 0.0 #f)
    (and passed (= (-> *skate-tricks* trick) 'none)
         (= (skate-trick-land! *skate-tricks* 2.0 0.0) 'clean)
         (= (-> *skate-tricks* combo-count) 0)
         (= (-> *skate-tricks* combo-points) 0.0))))

(defun skate-test-trick-pitch-and-multiplier-cap ()
  (skate-trick-reset! *skate-tricks*)
  (skate-trick-launch! *skate-tricks* 'ollie 0.5)
  (skate-trick-air-step! *skate-tricks* 0.1 0.0 #f)
  (let ((passed (> (skate-trick-board-pitch *skate-tricks*) 0.0)))
    (skate-trick-land! *skate-tricks* 2.0 0.0)
    (skate-trick-launch! *skate-tricks* 'nollie 0.5)
    (skate-trick-air-step! *skate-tricks* 0.1 0.0 #f)
    (set! passed (and passed (< (skate-trick-board-pitch *skate-tricks*) 0.0)))
    (skate-trick-land! *skate-tricks* 2.0 0.0)
    (skate-trick-reset! *skate-tricks*)
    (dotimes (i 10)
      (skate-trick-launch! *skate-tricks* (if (zero? (logand i 1)) 'ollie 'nollie) 0.5)
      (skate-trick-land! *skate-tricks* 2.0 0.0))
    (set! passed (and passed (= (-> *skate-tricks* combo-count) 10)
                     (= (-> *skate-tricks* multiplier) 8)
                     (= (-> *skate-tricks* combo-points) 625.0)))
    (skate-trick-bank! *skate-tricks*)
    (and passed (= (-> *skate-tricks* banked-points) 5000.0))))
