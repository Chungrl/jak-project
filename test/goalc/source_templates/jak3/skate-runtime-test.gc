;;-*-Lisp-*-
(in-package goal)

;; (AI-assisted) Verify the profile boundary with no target, mission or camera.
(defun skate-test-runtime-compatibility-gate ()
  (let ((passed (and (not *jak3-skate-enabled*)
                     (not (skate-runtime-camera-owned?)))))
    (dotimes (bits 16)
      (let* ((enabled? (nonzero? (logand bits 1)))
             (rc? (nonzero? (logand bits 2)))
             (locked? (nonzero? (logand bits 4)))
             (safe? (nonzero? (logand bits 8))))
        (set! passed
          (and passed (= (skate-runtime-eligible? enabled? rc? locked? safe?)
                         (if (= bits 9) #t #f))))))
    (skate-set-profile! 'original)
    passed))

(defun skate-test-runtime-lifecycle-reset ()
  (skate-set-profile! 'original)
  (let ((passed (and (skate-set-profile! 'skate)
                     (not (skate-runtime-camera-owned?)))))
    (set! (-> *jak3-skate-state* active?) #t)
    (set! (-> *jak3-skate-state* ground?) #t)
    (set! (-> *jak3-skate-state* incoming-impact) 12.0)
    (set! (-> *jak3-skate-state* pop-speed) 7.0)
    (set! (-> *jak3-skate-state* bail-time) 0.5)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 0.04)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.8 0.016)
    (skate-trick-launch! *skate-tricks* 'kickflip 0.5)
    (set! passed (and passed (skate-runtime-camera-owned?)
                     (skate-set-profile! 'misspelled)
                     (-> *jak3-skate-state* active?)
                     (= (-> *skate-input-state* event) 'ollie)))
    (skate-set-profile! 'original)
    (and passed (not *jak3-skate-enabled*)
         (not (skate-runtime-camera-owned?))
         (not (-> *jak3-skate-state* active?))
         (not (-> *jak3-skate-state* ground?))
         (= (-> *jak3-skate-state* incoming-impact) 0.0)
         (= (-> *jak3-skate-state* pop-speed) 0.0)
         (= (-> *jak3-skate-state* bail-time) 0.0)
         (= (-> *skate-input-state* phase) 'ready)
         (not (-> *skate-input-state* event))
         (= (-> *skate-tricks* phase) 'ground))))

(defun skate-test-runtime-controller-axis ()
  (and (= (skate-stick-axis 128) 0.0)
       (= (skate-stick-axis 140) 0.0)
       (= (skate-stick-axis 116) 0.0)
       (= (skate-stick-axis 0) -1.0)
       (= (skate-stick-axis 255) 1.0)
       (= (skate-stick-axis -1000) -1.0)
       (= (skate-stick-axis 1000) 1.0)
       (> (skate-stick-axis 160) 0.0)
       (< (skate-stick-axis 96) 0.0)
       (< (fabs (+ (skate-stick-axis 160) (skate-stick-axis 96))) 0.001)
       (< (skate-stick-axis 160) (skate-stick-axis 192))))
