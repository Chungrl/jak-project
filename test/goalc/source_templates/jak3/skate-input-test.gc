;;-*-Lisp-*-
(in-package goal)

;; (AI-assisted) Recorded normalized right-stick traces call the actual recognizer.
;; Controller mapping, camera suppression and game feel need desktop validation.
(defun skate-test-gesture ((preload-x float) (preload-y float)
                           (flick-x float) (flick-y float))
  (skate-input-reset! *skate-input-state*)
  (skate-input-sample! *skate-input-state* *skate-input-config* preload-x preload-y 0.02)
  (skate-input-sample! *skate-input-state* *skate-input-config* preload-x preload-y 0.02)
  (skate-input-sample! *skate-input-state* *skate-input-config* flick-x flick-y 0.016)
  (skate-input-consume! *skate-input-state*))

(defun skate-test-input-tricks ()
  (and (= (skate-test-gesture 0.0 -0.8 0.0 0.8) 'ollie)
       (= (skate-test-gesture 0.0 0.8 0.0 -0.8) 'nollie)
       (= (skate-test-gesture 0.0 -0.8 -0.8 0.8) 'kickflip)
       (= (skate-test-gesture 0.0 -0.8 0.8 0.8) 'heelflip)
       (= (skate-test-gesture 0.0 -0.8 -0.8 0.0) 'bs-shuvit)
       (= (skate-test-gesture 0.0 -0.8 0.8 0.0) 'fs-shuvit)
       (= (skate-test-gesture 0.6 -0.8 -0.8 0.8) 'varial-kickflip)
       (= (skate-test-gesture -0.6 -0.8 0.8 0.8) 'varial-heelflip)))

(defun skate-test-input-nollie-variants ()
  (and (= (skate-test-gesture 0.0 0.8 -0.8 -0.8) 'nollie-kickflip)
       (= (skate-test-gesture 0.0 0.8 0.8 -0.8) 'nollie-heelflip)
       (= (skate-test-gesture 0.0 0.8 -0.8 0.0) 'nollie-bs-shuvit)
       (= (skate-test-gesture 0.0 0.8 0.8 0.0) 'nollie-fs-shuvit)
       (= (skate-test-gesture 0.6 0.8 -0.8 -0.8) 'nollie-varial-kickflip)
       (= (skate-test-gesture -0.6 0.8 0.8 -0.8) 'nollie-varial-heelflip)))

(defun skate-test-input-rejects-noise-and-short-preload ()
  (skate-input-reset! *skate-input-state*)
  (dotimes (frame 120)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.1 -0.1 0.016))
  (let ((quiet? (and (= (-> *skate-input-state* phase) 'ready)
                     (not (-> *skate-input-state* event)))))
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 0.016)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.8 0.016)
    (and quiet? (not (skate-input-consume! *skate-input-state*)))))

(defun skate-test-input-buffer-and-lock ()
  (skate-test-gesture 0.0 -0.8 0.0 0.8)
  (let ((strength (-> *skate-input-state* event-strength))
        (one-shot? #t))
    ;; The consumed strength survives; held input cannot mint another gesture.
    (dotimes (frame 4)
      (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 0.02))
    (set! one-shot? (and (= (-> *skate-input-state* event-serial) 1)
                         (not (skate-input-consume! *skate-input-state*))
                         (= (-> *skate-input-state* event-strength) strength)))
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.0 0.016)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 0.02)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 0.02)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.8 0.016)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.0 0.1)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.0 0.05)
    (let ((buffered? (= (-> *skate-input-state* event) 'ollie)))
      (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.0 0.02)
      (and one-shot? buffered? (= (-> *skate-input-state* event-serial) 2)
           (not (skate-input-consume! *skate-input-state*))))))

(defun skate-test-input-invalid-timing ()
  (skate-test-gesture 0.0 -0.8 0.0 0.8)
  (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 0.2)
  (let ((gap? (and (= (-> *skate-input-state* phase) 'locked)
                   (not (-> *skate-input-state* event)))))
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.0 0.016)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 0.04)
    (dotimes (frame 3)
      (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.0 0.08))
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.8 0.016)
    (let ((slow? (not (skate-input-consume! *skate-input-state*))))
      (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 -0.1)
      (and gap? slow? (= (-> *skate-input-state* phase) 'locked)
           (not (-> *skate-input-state* event))))))

(defun skate-test-input-at-frame-rate ((fps int))
  (let ((dt (/ 1.0 (the float fps))))
    (skate-input-reset! *skate-input-state*)
    (dotimes (frame (/ fps 15))
      (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 dt))
    (skate-input-sample! *skate-input-state* *skate-input-config* -0.8 0.8 dt)
    (and (= (skate-input-consume! *skate-input-state*) 'kickflip)
         (> (-> *skate-input-state* event-strength) 0.15)
         (< (-> *skate-input-state* event-strength) 0.18))))

(defun skate-test-input-configuration ()
  (let ((sensitivity (-> *skate-input-config* sensitivity))
        (dead-zone (-> *skate-input-config* dead-zone))
        (passed #t))
    (set! (-> *skate-input-config* sensitivity) 0.5)
    (set! passed (not (skate-test-gesture 0.0 -0.8 0.0 0.8)))
    (set! (-> *skate-input-config* sensitivity) 2.0)
    (set! passed (and passed (= (skate-test-gesture 0.0 -0.4 0.0 0.4) 'ollie)))
    (set! (-> *skate-input-config* dead-zone) 0.4)
    (skate-input-reset! *skate-input-state*)
    (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.15 0.016)
    (set! passed (and passed (= (-> *skate-input-state* phase) 'ready)))
    (set! (-> *skate-input-config* sensitivity) sensitivity)
    (set! (-> *skate-input-config* dead-zone) dead-zone)
    (skate-input-reset! *skate-input-state*)
    passed))

(defun skate-test-input-event-snapshots ()
  (skate-input-reset! *skate-input-state*)
  (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 0.04)
  (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.8 0.016)
  (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 0.0 0.016)
  ;; Beginning another preload cannot change the buffered launch's pop energy.
  (skate-input-sample! *skate-input-state* *skate-input-config* 0.0 -0.8 0.1)
  (and (= (skate-input-consume! *skate-input-state*) 'ollie)
       (< (fabs (- (-> *skate-input-state* event-strength) 0.1)) 0.001)
       (< (fabs (- (-> *skate-input-state* event-preload-time) 0.04)) 0.001)
       (< (fabs (- (-> *skate-input-state* event-flick-speed) 100.0)) 0.001)
       (not (skate-input-consume! *skate-input-state*))))
