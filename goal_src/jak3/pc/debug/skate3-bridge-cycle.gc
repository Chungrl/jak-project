;;-*-Lisp-*-
(in-package goal)

;; (AI-assisted) Manual check of the Skate 3 bridge's hand-over paths. Not part
;; of any DGO. Loaded the same way as skate3-bridge-test.gc. Switches the bridge
;; off and on while riding, does a kickflip, gets Jak off the board and back on,
;; and reports the bridge's state after each step, with screenshots.
;;
;; Written as a step function called once a frame: a spawned function gets very
;; little stack to suspend with, so the process itself only loops and suspends.

(define *sk3c-phase* 0)
(define *sk3c-timer* 0)
(define *sk3c-steps* 0)

(defun sk3c-shot ((name string))
  (set! (-> *screen-shot-settings* width) 1920)
  (set! (-> *screen-shot-settings* height) 1080)
  (set! (-> *screen-shot-settings* msaa) 4)
  (copyn-charp<-string (-> *screen-shot-settings* name) name 244)
  (pc-screen-shot)
  (none))

(defun sk3c-log ((label string))
  (format 0 "SK3TEST ~S target ~A enabled ~A active ~A rig ~D postbind ~A"
          label (-> *target* state name)
          *jak3-skate3-bridge-enabled* *jak3-skate3-bridge-active* *skate3-rig-count*
          (if (= (-> *target* skel postbind-function) skate3-bridge-postbind)
              'bridge
              (if (-> *target* skel postbind-function) 'other #f)))
  (format 0 " engine state ~D tricks ~D name ~S total ~D"
          (-> *skate3-bridge-io* state) (-> *skate3-bridge-io* tricks) *skate3-trick-name*
          (the int (-> *skate3-bridge-io* total)))
  (format 0 " engine pos ~m ~m ~m wheels ~D~%"
          (-> *skate3-bridge-io* position x) (-> *skate3-bridge-io* position y)
          (-> *skate3-bridge-io* position z) (-> *skate3-bridge-io* wheels))
  (none))

(defun sk3c-next ((frames int))
  "Move to the next phase after waiting this many frames."
  (+! *sk3c-phase* 1)
  (set! *sk3c-timer* frames)
  (none))

(defun sk3c-wait-active ((label string))
  "Move on once the bridge is up (or has given up)."
  (+! *sk3c-timer* 1)
  (when (or *jak3-skate3-bridge-active* (not *jak3-skate3-bridge-enabled*) (> *sk3c-timer* 900))
    (format 0 "SK3TEST ~S activation took ~D frames, active ~A~%" label *sk3c-timer* *jak3-skate3-bridge-active*)
    (sk3c-next 90))
  (none))

(defun sk3c-tick ()
  (let ((io *skate3-bridge-io*)
        (phase *sk3c-phase*))
    (cond
      ((and (> *sk3c-timer* 0) (!= phase 2) (!= phase 5) (!= phase 14))
       (if (= phase 11) (+! *sk3c-steps* (the-as int (-> io steps))))
       ;; after the flip: watch whether the skater lands or bails, and recovers
       (if (and (= phase 10) (= (mod *sk3c-timer* 30) 0)) (sk3c-log "4-after-flip"))
       (+! *sk3c-timer* -1))
      ((= phase 0)
       (when (and *target* (!= (-> *target* next-state name) 'target-continue))
         (logior! (-> *game-info* features) (game-feature board))
         (logior! (-> *game-info* debug-features) (game-feature board))
         (send-event *target* 'change-mode 'board #f)
         (sk3c-next 240)))
      ((= phase 1)
       (set! *jak3-skate3-bridge-scripted-input* #t)
       (skate3-bridge-clear-input! io)
       (set! *jak3-skate3-bridge-enabled* #t)
       (sk3c-next 0))
      ((= phase 2) (sk3c-wait-active "first"))
      ((= phase 3)
       (sk3c-log "1-on")
       ;; off while riding: Jak goes back to the jetboard
       (set! *jak3-skate3-bridge-enabled* #f)
       (sk3c-next 90))
      ((= phase 4)
       (sk3c-log "2-off")
       (sk3c-shot "sk3-c2-off")
       ;; on again: the engine is already loaded
       (set! *jak3-skate3-bridge-enabled* #t)
       (sk3c-next 0))
      ((= phase 5) (sk3c-wait-active "second"))
      ((= phase 6)
       (sk3c-log "3-on-again")
       ;; kickflip: right stick down, then up and to the right
       (set! (-> io right-y) -1.0)
       (sk3c-next 10))
      ((= phase 7)
       (set! (-> io right-x) 0.7)
       (set! (-> io right-y) 0.7)
       (sk3c-next 5))
      ((= phase 8)
       (skate3-bridge-clear-input! io)
       (sk3c-next 22))
      ((= phase 9)
       (sk3c-log "4-flip-air")
       (sk3c-shot "sk3-c4-flip")
       (sk3c-next 600))
      ((= phase 10)
       (sk3c-log "4-flip-landed")
       (sk3c-shot "sk3-c4-landed")
       ;; frame-time stepping: the pad is read (and is idle), steps follow the clock
       (set! *jak3-skate3-bridge-scripted-input* #f)
       (set! *sk3c-steps* 0)
       (sk3c-next 120))
      ((= phase 11)
       (format 0 "SK3TEST 5-clocked ~D engine steps in 120 frames~%" *sk3c-steps*)
       (set! *jak3-skate3-bridge-scripted-input* #t)
       ;; off the board with the bridge still enabled
       (send-event *target* 'end-mode 'board)
       (sk3c-next 180))
      ((= phase 12)
       (sk3c-log "6-off-board")
       (sk3c-shot "sk3-c6-off-board")
       ;; back on: the bridge takes over again by itself
       (send-event *target* 'change-mode 'board #f)
       (sk3c-next 60))
      ((= phase 13) (sk3c-next 0))
      ((= phase 14) (sk3c-wait-active "third"))
      ((= phase 15)
       (sk3c-log "7-back-on")
       (sk3c-shot "sk3-c7-back-on")
       (set! *jak3-skate3-bridge-enabled* #f)
       (sk3c-next 30))
      ((= phase 16)
       (sk3c-log "8-end")
       (set! *jak3-skate3-bridge-scripted-input* #f)
       (format 0 "SK3TEST done~%")
       (sk3c-next 0))))
  (none))

(set! *sk3c-phase* 0)
(set! *sk3c-timer* 0)
(format 0 "SK3TEST begin~%")
(process-spawn-function process :name "sk3-cycle"
  (lambda :behavior process ()
    (loop
      (sk3c-tick)
      (suspend)))
  :to *display-pool*)
