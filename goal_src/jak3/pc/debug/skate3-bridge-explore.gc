;;-*-Lisp-*-
(in-package goal)

;; (AI-assisted) Manual check of the Skate 3 bridge away from the spot the other
;; checks use. Not part of any DGO.
;;  1. From the Spargus start, heads downhill towards the sea with push held,
;;     and reports where Jak goes and what the bridge does at the water.
;;  2. Loads another level (Haven City's port), mounts the board there, pushes
;;     and ollies.

(define *sk3e-phase* 0)
(define *sk3e-timer* 0)
(define *sk3e-count* 0)

(defun sk3e-shot ((name string))
  (set! (-> *screen-shot-settings* width) 1920)
  (set! (-> *screen-shot-settings* height) 1080)
  (set! (-> *screen-shot-settings* msaa) 4)
  (copyn-charp<-string (-> *screen-shot-settings* name) name 244)
  (pc-screen-shot)
  (none))

(defun sk3e-log ((label string))
  (let ((io *skate3-bridge-io*))
    (format 0 "SK3TEST ~S target ~A enabled ~A active ~A in-water ~A"
            label (-> *target* state name)
            *jak3-skate3-bridge-enabled* *jak3-skate3-bridge-active* *jak3-skate3-bridge-in-water*)
    (format 0 " water ~A at ~m touch ~A state ~D wheels ~D"
            (logtest? (water-flag active) (-> *target* water flags))
            (-> *target* water height)
            (logtest? (water-flag touch-water) (-> *target* water flags))
            (-> io state) (-> io wheels))
    (format 0 " pos ~m ~m ~m world ~D tris ~D rails~%"
            (-> *target* control trans x) (-> *target* control trans y) (-> *target* control trans z)
            (-> io world-triangles) (-> io world-rails)))
  (none))

(defun sk3e-next ((frames int))
  (+! *sk3e-phase* 1)
  (set! *sk3e-timer* frames)
  (none))

(defun sk3e-tick ()
  (let ((io *skate3-bridge-io*)
        (phase *sk3e-phase*))
    (cond
      ((not *target*)
       #f)
      ((> *sk3e-timer* 0)
       (+! *sk3e-timer* -1)
       ;; once a second while heading for the sea, and while riding in the port
       (if (and (or (= phase 3) (= phase 8)) (= (mod *sk3e-timer* 20) 0))
           (sk3e-log (if (= phase 3) "sea" "port"))))
      ((= phase 0)
       (when (!= (-> *target* next-state name) 'target-continue)
         (set! *jak3-skate3-bridge-scripted-input* #t)
         (skate3-bridge-clear-input! io)
         (send-event *target* 'change-mode 'board #f)
         (sk3e-next 0)))
      ((= phase 1)
       (+! *sk3e-count* 1)
       (if (or (and *jak3-skate3-bridge-active* (> *sk3e-count* 120)) (> *sk3e-count* 1500))
           (sk3e-next 0)))
      ((= phase 2)
       ;; downhill from the Spargus start, the way the board rolls by itself
       (set-vector! *skate3-bridge-restart-pos* (meters 2297.9) (meters 4.6) (meters -124.8) 1.0)
       (set-vector! *skate3-bridge-restart-dir* 0.31 0.0 -0.95 0.0)
       (set! *skate3-bridge-restart-speed* (meters 6))
       (set! *skate3-bridge-restart?* #t)
       (set! (-> io buttons) (the-as uint #x1000))
       (sk3e-next 300))
      ((= phase 3)
       (sk3e-log "sea-end")
       (sk3e-shot "sk3-e-sea")
       (skate3-bridge-clear-input! io)
       (sk3e-next 30))
      ((= phase 4)
       ;; another level
       (set! *jak3-skate3-bridge-scripted-input* #f)
       (start 'play (get-continue-by-name *game-info* "ctyport-start"))
       (set! *sk3e-count* 0)
       (sk3e-next 0))
      ((= phase 5)
       (+! *sk3e-count* 1)
       (when (or (and (!= (-> *target* next-state name) 'target-continue) (> *sk3e-count* 600))
                 (> *sk3e-count* 3000))
         (format 0 "SK3TEST port loaded after ~D frames, target ~A~%" *sk3e-count* (-> *target* state name))
         (set! *jak3-skate3-bridge-scripted-input* #t)
         (skate3-bridge-clear-input! io)
         (send-event *target* 'change-mode 'board #f)
         (set! *sk3e-count* 0)
         (sk3e-next 0)))
      ((= phase 6)
       (+! *sk3e-count* 1)
       (if (or (and *jak3-skate3-bridge-active* (> *sk3e-count* 180)) (> *sk3e-count* 1500))
           (sk3e-next 0)))
      ((= phase 7)
       (sk3e-log "port-start")
       (sk3e-shot "sk3-e-port-start")
       (set! (-> io buttons) (the-as uint #x1000))
       (sk3e-next 300))
      ((= phase 8)
       (skate3-bridge-clear-input! io)
       (set! (-> io right-y) -1.0)
       (sk3e-next 9))
      ((= phase 9)
       (set! (-> io right-y) 1.0)
       (sk3e-next 5))
      ((= phase 10)
       (skate3-bridge-clear-input! io)
       (sk3e-next 30))
      ((= phase 11)
       (sk3e-log "port-air")
       (sk3e-shot "sk3-e-port-air")
       (sk3e-next 240))
      ((= phase 12)
       (sk3e-log "port-end")
       (set! *jak3-skate3-bridge-scripted-input* #f)
       (format 0 "SK3TEST done~%")
       (sk3e-next 0))))
  (none))

(set! *sk3e-phase* 0)
(set! *sk3e-timer* 0)
(set! *sk3e-count* 0)
(format 0 "SK3TEST begin~%")
(process-spawn-function process :name "sk3-explore"
  (lambda :behavior process ()
    (loop
      (sk3e-tick)
      (suspend)))
  :to *display-pool*)
