;;-*-Lisp-*-
(in-package goal)

;; (AI-assisted) Manual check: grinds reached the way a player reaches them.
;; For each long, level grind rail the engine found around Jak (this needs an
;; engine library built with the local sk_debug_rail addition), the skater is
;; restarted on the ground beside it, rolling towards it at a shallow angle,
;; and does a Flickit ollie as he closes on it. A grind that follows a pop is
;; reported. Each rail is tried from both sides and at three ollie distances.
;; Not part of any DGO.

(define *sk3og-phase* 0)   ;; 0 mount, 1 wait, 2 next trial, 3 approach, 4 flick down, 5 flick up, 6 watch, 7 finished
(define *sk3og-timer* 0)
(define *sk3og-count* 0)
(define *sk3og-rail* 0)
(define *sk3og-variant* 6)  ;; 0..5 within a rail; 6 means move to the next rail
(define *sk3og-rails-tried* 0)
(define *sk3og-trials* 0)
(define *sk3og-found* 0)
(define *sk3og-pops* 0)
(define *sk3og-grinds* 0)
(define *sk3og-reported* #f)
(define *sk3og-grind-frames* 0)
(define *sk3og-shot-taken* #f)
(define *sk3og-trigger* 0.0)
(define *sk3og-a* (new 'global 'vector))
(define *sk3og-dir* (new 'global 'vector))
(define *sk3og-normal* (new 'global 'vector))
(define *sk3og-len* 0.0)
(define *sk3og-min-lateral* 0.0)
(define *sk3og-trigger-dy* 0.0)
(define *sk3og-peak-dy* 0.0)
(defconstant SK3OG_MAX_RAILS 12)

(defun sk3og-shot ((name string))
  (set! (-> *screen-shot-settings* width) 1920)
  (set! (-> *screen-shot-settings* height) 1080)
  (set! (-> *screen-shot-settings* msaa) 4)
  (copyn-charp<-string (-> *screen-shot-settings* name) name 244)
  (pc-screen-shot)
  (none))

(defun sk3og-find-rail ()
  "Load the next long, level rail into *sk3og-a* / dir / normal. #f when there are none left."
  (let ((io *skate3-bridge-io*)
        (found #f)
        (ended #f))
    (while (and (not found) (not ended))
      (set! (-> io command) 10)
      (set! (-> io world-count) (the-as uint *sk3og-rail*))
      (cond
        ((!= (pc-skate3-bridge io) 0)
         (if (= *sk3og-rail* 0)
             (format 0 "SK3TEST FAILED the engine library does not report its rails (status ~D)~%" (-> io status)))
         (set! ended #t))
        (else
         (let* ((a (-> io position))
                (dir (vector-! (new 'stack-no-clear 'vector) (-> io velocity) a))
                (len (vector-length dir)))
           (when (and (> len (meters 4)) (< (fabs (-> dir y)) (* 0.1 len)))
             (vector-copy! *sk3og-a* a)
             (set! (-> dir y) 0.0)
             (vector-normalize! dir 1.0)
             (vector-copy! *sk3og-dir* dir)
             (set-vector! *sk3og-normal* (-> dir z) 0.0 (- (-> dir x)) 0.0)
             (set! *sk3og-len* len)
             (set! found #t)))))
      (+! *sk3og-rail* 1))
    found))

(defun sk3og-start-trial ()
  "Restart the skater beside the rail, rolling towards it."
  (let* ((side (if (< *sk3og-variant* 3) 1.0 -1.0))
         (along (fmin (- *sk3og-len* (meters 0.5)) (meters 6.5)))
         (target (vector+float*! (new 'stack-no-clear 'vector) *sk3og-a* *sk3og-dir* (+ (meters 0.5) along)))
         (heading (new 'stack-no-clear 'vector)))
    ;; from the ollie gesture to landing the board covers about 2 m sideways at this angle
    (set! *sk3og-trigger* (case (mod *sk3og-variant* 3)
                            ((0) (meters 1.6))
                            ((1) (meters 2.0))
                            (else (meters 2.4))))
    (vector+float*! *skate3-bridge-restart-pos* *sk3og-a* *sk3og-dir* (meters 0.5))
    (vector+float*! *skate3-bridge-restart-pos* *skate3-bridge-restart-pos* *sk3og-normal* (* side (meters 3)))
    (+! (-> *skate3-bridge-restart-pos* y) (meters 0.4))
    (vector-! heading target *skate3-bridge-restart-pos*)
    (set! (-> heading y) 0.0)
    (vector-normalize! heading 1.0)
    (vector-copy! *skate3-bridge-restart-dir* heading)
    (set! *skate3-bridge-restart-speed* (meters 5.5))
    (set! *skate3-bridge-restart?* #t))
  (skate3-bridge-clear-input! *skate3-bridge-io*)
  (set! *sk3og-pops* (the-as int (-> *skate3-bridge-io* pops)))
  (set! *sk3og-grinds* (the-as int (-> *skate3-bridge-io* grinds)))
  (set! *sk3og-reported* #f)
  (set! *sk3og-grind-frames* 0)
  (set! *sk3og-min-lateral* (meters 100))
  (set! *sk3og-trigger-dy* (meters -100))
  (set! *sk3og-peak-dy* (meters -100))
  (+! *sk3og-trials* 1)
  (none))

(defun sk3og-finish ()
  (format 0 "SK3TEST ollie grinds: ~D of ~D approaches on ~D rails ended in a grind after a pop~%"
          *sk3og-found* *sk3og-trials* *sk3og-rails-tried*)
  (set! *jak3-skate3-bridge-scripted-input* #f)
  (format 0 "SK3TEST done~%")
  (set! *sk3og-phase* 7)
  (none))

(defun sk3og-tick ()
  (let ((io *skate3-bridge-io*))
    ;; a grind after a pop, at any point in a trial
    (when (and (>= *sk3og-phase* 3) (<= *sk3og-phase* 6))
      (let ((grinding (and (>= (-> io state) 400) (< (-> io state) 500))))
        (when (and (not *sk3og-reported*)
                   (> (the-as int (-> io pops)) *sk3og-pops*)
                   (or grinding (!= (the-as int (-> io grinds)) *sk3og-grinds*)))
          (set! *sk3og-reported* #t)
          (+! *sk3og-found* 1)
          (format 0 "SK3TEST OLLIE GRIND rail ~D variant ~D: state ~D trick ~S"
                  (+ *sk3og-rail* -1) *sk3og-variant* (-> io state) *skate3-trick-name*)
          (format 0 " pos ~m ~m ~m~%" (-> io position x) (-> io position y) (-> io position z)))
        (when (and grinding *sk3og-reported*)
          (+! *sk3og-grind-frames* 1)
          (when (and (not *sk3og-shot-taken*) (= *sk3og-grind-frames* 12))
            (set! *sk3og-shot-taken* #t)
            (sk3og-shot "sk3-og-grind")))))
    (when (and (>= *sk3og-phase* 3) (<= *sk3og-phase* 6))
      (let* ((offset (vector-! (new 'stack-no-clear 'vector) (-> io position) *sk3og-a*))
             (lateral (fabs (vector-dot offset *sk3og-normal*))))
        (if (< lateral *sk3og-min-lateral*) (set! *sk3og-min-lateral* lateral))
        (if (> (-> offset y) *sk3og-peak-dy*) (set! *sk3og-peak-dy* (-> offset y)))))
    (cond
      ((= *sk3og-phase* 0)
       (when (and *target* (!= (-> *target* next-state name) 'target-continue))
         (set! *jak3-skate3-bridge-scripted-input* #t)
         (skate3-bridge-clear-input! io)
         (send-event *target* 'change-mode 'board #f)
         (set! *sk3og-count* 0)
         (set! *sk3og-phase* 1)))
      ((= *sk3og-phase* 1)
       (+! *sk3og-count* 1)
       (cond
         ((and *jak3-skate3-bridge-active* (> *sk3og-count* 120))
          (set! *sk3og-phase* 2))
         ((> *sk3og-count* 1500)
          (format 0 "SK3TEST FAILED bridge did not activate~%")
          (set! *sk3og-phase* 7))))
      ((and (= *sk3og-phase* 2) (not *jak3-skate3-bridge-active*))
       ;; Jak has been knocked off the board or the bridge has let go: report it once and get back on
       (when (= *sk3og-count* 0)
         (format 0 "SK3TEST   bridge not driving: Jak ~A, enabled ~A, in-water ~A, hit points ~f"
                 (-> *target* state name) *jak3-skate3-bridge-enabled* *jak3-skate3-bridge-in-water*
                 (-> *target* fact health))
         (let ((attacker (handle->process (-> *target* attack-info attacker))))
           (format 0 "; last attack mode ~A by ~A at ~m ~m ~m~%"
                   (-> *target* attack-info mode)
                   (if attacker (-> attacker name) "nobody")
                   (-> *target* control trans x) (-> *target* control trans y) (-> *target* control trans z)))
         (set! *jak3-skate3-bridge-enabled* #t))
       (+! *sk3og-count* 1)
       (when (and (= (mod *sk3og-count* 120) 1)
                  (not (focus-test? *target* dead grabbed board)))
         (send-event *target* 'change-mode 'board #f))
       (when (> *sk3og-count* 1200)
         (format 0 "SK3TEST FAILED could not get back on the board~%")
         (sk3og-finish)))
      ((= *sk3og-phase* 2)
       (set! *sk3og-count* 0)
       (when (>= *sk3og-variant* 6)
         (set! *sk3og-variant* 0)
         (cond
           ((and (< *sk3og-rails-tried* SK3OG_MAX_RAILS) (sk3og-find-rail))
            (+! *sk3og-rails-tried* 1))
           (else
            (sk3og-finish))))
       (when (= *sk3og-phase* 2)
         (sk3og-start-trial)
         (set! *sk3og-timer* 170)
         (set! *sk3og-count* 0)
         (set! *sk3og-phase* 3)))
      ((= *sk3og-phase* 3)
       ;; rolling in: ollie when close enough to the rail's line
       (+! *sk3og-count* 1)
       (+! *sk3og-timer* -1)
       (let* ((offset (vector-! (new 'stack-no-clear 'vector) (-> io position) *sk3og-a*))
              (lateral (fabs (vector-dot offset *sk3og-normal*))))
         (cond
           ((and (> *sk3og-count* 8) (< lateral *sk3og-trigger*))
            (set! *sk3og-trigger-dy* (-> offset y))
            (set! (-> io right-y) -1.0)
            (set! *sk3og-count* 9)
            (set! *sk3og-phase* 4))
           ((<= *sk3og-timer* 0)
            (format 0 "SK3TEST   rail ~D variant ~D never came within reach: closest ~m, height ~m~%"
                    (+ *sk3og-rail* -1) *sk3og-variant* *sk3og-min-lateral* *sk3og-peak-dy*)
            (+! *sk3og-variant* 1)
            (set! *sk3og-phase* 2)))))
      ((= *sk3og-phase* 4)
       (+! *sk3og-count* -1)
       (when (<= *sk3og-count* 0)
         (set! (-> io right-y) 1.0)
         (set! *sk3og-count* 5)
         (set! *sk3og-phase* 5)))
      ((= *sk3og-phase* 5)
       (+! *sk3og-count* -1)
       (when (<= *sk3og-count* 0)
         (skate3-bridge-clear-input! io)
         (set! *sk3og-timer* 130)
         (set! *sk3og-phase* 6)))
      ((= *sk3og-phase* 6)
       (+! *sk3og-timer* -1)
       (when (<= *sk3og-timer* 0)
         (if *sk3og-reported*
             (format 0 "SK3TEST   ground for ~D frames, trick ~S, total ~D~%" *sk3og-grind-frames*
                     *skate3-trick-name* (the int (-> io total))))
         (format 0 "SK3TEST   rail ~D variant ~D: pops ~D, at the ollie ~m below the rail, peaked ~m above, closest ~m"
                 (+ *sk3og-rail* -1) *sk3og-variant* (- (the-as int (-> io pops)) *sk3og-pops*)
                 (- *sk3og-trigger-dy*) *sk3og-peak-dy* *sk3og-min-lateral*)
         (format 0 ", state ~D, Jak ~A, bridge ~A~%" (-> io state) (-> *target* state name) *jak3-skate3-bridge-active*)
         (+! *sk3og-variant* 1)
         (set! *sk3og-phase* 2)))))
  (none))

(set! *sk3og-phase* 0)
(set! *sk3og-variant* 6)
(set! *sk3og-rail* 0)
(set! *sk3og-rails-tried* 0)
(set! *sk3og-trials* 0)
(set! *sk3og-found* 0)
(format 0 "SK3TEST begin~%")
(process-spawn-function process :name "sk3-ollie-grind"
  (lambda :behavior process ()
    (loop
      (sk3og-tick)
      (suspend)))
  :to *display-pool*)
