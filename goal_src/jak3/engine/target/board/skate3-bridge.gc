;;-*-Lisp-*-
(in-package goal)

;; (AI-assisted) Optional bridge to an external Skate 3 gameplay engine.
;;
;; The engine is not part of this project. gk loads it at run time from the
;; library named by OPENGOAL_SKATE3_DLL, with data the player converted from
;; their own copy of Skate 3 (OPENGOAL_SKATE3_ASSETS). See
;; game/kernel/jak3/skate3_bridge.h. With those unset the bridge stays off and
;; the jetboard behaves exactly as before. With them set, riding the jetboard
;; is skateboarding, and Jak is given the jetboard if he does not have it yet.
;;
;; The engine rides the game's own collision: the background, and the meshes of
;; solid objects such as platforms, doors and obstacles. The triangles in a
;; square around Jak are gathered through the collide cache and handed over,
;; and gathered again as he moves, or every three quarters of a second while
;; there are objects in it, since those can move. While the bridge is active it replaces the
;; jetboard's own movement update: Jak is put where the engine's board is, and
;; the skater's pose is fitted to his skeleton and written over his bones after
;; his own animation. Moving collision and the Skate camera are not wired.

(#when PC_PORT

;; Mirrors jak3::skate3_bridge::BridgeIO. Game units and game axes throughout.
(deftype skate3-bridge-io (structure)
  ((position      vector :inline) ;; in: activation position. out: skater root
   (velocity      vector :inline) ;; out: board velocity, units per second
   (forward       vector :inline) ;; in: activation facing. out: flattened travel direction
   (command       int32)          ;; in: see jak3::skate3_bridge::Command
   (status        int32)          ;; out: 0 ok, negative on failure
   (buttons       uint32)         ;; in: XInput button bits
   (left-x        float)          ;; in: sticks, -1..1, up and right positive
   (left-y        float)
   (right-x       float)
   (right-y       float)
   (left-trigger  float)          ;; in: 0..1
   (right-trigger float)
   (state         uint32)         ;; out: 100s riding, 200s air, 300 bail, 400s grind
   (wheels        uint32)         ;; out: wheels on the ground
   (pops          uint32)         ;; out: counters, only ever increase
   (landings      uint32)
   (grinds        uint32)
   (bails         uint32)
   (tick          uint32)         ;; out: engine steps since the session started
   (world-tris      uint32)       ;; in: address of an inline array of collide-cache-tri
   (world-count     uint32)       ;; in: triangles at world-tris
   (world-triangles uint32)       ;; out: triangles in the engine's installed world
   (world-rails     uint32)       ;; out: grind rails the engine found in them
   (rig-bones       uint32)       ;; in: address of an inline array of skate3-rig-bone
   (rig-count       uint32)       ;; in: host bones in the rig
   (rig-pose        uint32)       ;; in: address of an inline array of matrix to fill
   (unit-scale      float)        ;; in: how much larger than his model Jak is drawn
   (dt              float)        ;; in: seconds of game time for a step; 0 runs exactly one
   (steps           uint32)       ;; out: fixed engine steps the last step command ran
   (trick-name      string)       ;; in: string of at least 64 characters for the last trick
   (tricks          uint32)       ;; out: tricks announced so far; a change means a new name
   (sequence-active int32)        ;; out: nonzero while a run of tricks is being scored
   (sequence        float)        ;; out: points of the running sequence
   (multiplier      float)        ;; out
   (total           float)        ;; out: points landed this session
   (world-scale     float)        ;; in: size of the skating relative to Jak's own size
   )
  :size-assert #xb4
  )

;; Mirrors jak3::skate3_bridge::RigBone: one of Jak's joints, for the rig setup.
(deftype skate3-rig-bone (structure)
  ((inv-bind matrix :inline) ;; the joint's bind-pose field, which is the inverse bind matrix
   (name     string)         ;; joint name, or 0
   (parent   int32)          ;; index of the parent node, or -1
   (pad      uint32 2)
   )
  :size-assert #x50
  )

(defconstant SKATE3_RIG_MAX_BONES 96)
;; Jak's first three skeleton nodes are not body joints (the unnamed root, align
;; and prejoint); align in particular carries his movement, so they are left alone.
(defconstant SKATE3_RIG_FIRST_BONE 3)

(define-extern pc-skate3-bridge (function skate3-bridge-io int))
;; Defined by board-states, which loads after this file.
(define-extern target-board-get-off (state handle symbol target))

(define *jak3-skate3-bridge-enabled* #f)
(define *jak3-skate3-bridge-active* #f)
;; How big the skating is next to Jak. At 1.0 the board and the speeds are those
;; of a real skater Jak's height, which looks small and slow beside his build
;; and in his world; larger values scale the board, the speeds and the heights
;; up together. Changing it takes effect the next time the board is mounted or
;; the bridge is switched on, and restarts the engine (several seconds).
(define *jak3-skate3-bridge-world-scale* 1.6)
;; The jetboard damages anything it touches, which turns bystanders hostile.
;; While the bridge drives the board that is switched off unless this is #f.
(define *jak3-skate3-bridge-harmless* #t)
;; Whether gk was started with the bridge's environment variables: 'unknown
;; until first asked, then #t or #f.
(define *jak3-skate3-bridge-configured* 'unknown)
;; For checks and tools: set the position and facing, then the flag, and the
;; skater is restarted there on the next frame the bridge drives.
(define *skate3-bridge-restart?* #f)
(define *skate3-bridge-restart-pos* (new 'global 'vector))
(define *skate3-bridge-restart-dir* (new 'global 'vector))
;; Speed along that facing to restart with, in units per second; 0 for a standstill.
(define *skate3-bridge-restart-speed* 0.0)
;; Set while the bridge has stepped aside because Jak is in deep water, which the
;; jetboard can cross and a skateboard cannot. It comes back once he is out.
(define *jak3-skate3-bridge-in-water* #f)
(define *skate3-bridge-dry-time* (the-as time-frame 0))
;; When #t the pad is not read, so a test can drive the input fields directly.
(define *jak3-skate3-bridge-scripted-input* #f)
(define *skate3-bridge-io* (new 'global 'skate3-bridge-io))
(define *skate3-rig-bones* (the-as (inline-array skate3-rig-bone) (malloc 'global (* 80 SKATE3_RIG_MAX_BONES))))
(define *skate3-rig-pose* (the-as (inline-array matrix) (malloc 'global (* 64 SKATE3_RIG_MAX_BONES))))
;; Bones in the rig the engine was given; 0 until a setup succeeds.
(define *skate3-rig-count* 0)
(define *skate3-trick-name* (new 'global 'string 64 (the-as string #f)))
(define *skate3-hud-string* (new 'global 'string 128 (the-as string #f)))
;; The trick counter when the name was last shown, and when that was.
(define *skate3-hud-tricks* 0)
(define *skate3-hud-trick-time* (the-as time-frame 0))
(define *jak3-skate3-bridge-hud* #t)

;; The world handed to the engine is a square of 5 x 5 cells around Jak. Each
;; cell is one collide-cache fill, which holds at most 461 triangles.
(defconstant SKATE3_WORLD_CELLS 5)
(defconstant SKATE3_WORLD_CELL_SIZE (meters 8))
(defconstant SKATE3_WORLD_HALF_HEIGHT (meters 12))
;; Gather again once Jak is this far from the centre of the last gather.
(defconstant SKATE3_WORLD_REFRESH_DIST (meters 8))
(define *skate3-bridge-world-center* (new 'global 'vector))
;; Cells of the last gather that filled the collide cache and so lost triangles.
(define *skate3-bridge-world-overflows* 0)
;; Whether the last gather had solid objects in it, and when it was.
(define *skate3-bridge-world-objects?* #f)
(define *skate3-bridge-world-time* (the-as time-frame 0))
;; Frames the engine has had the skater off the board (its own walking mode).
(define *skate3-bridge-off-board-frames* 0)
;; The engine only knows the level's solid background. If Jak drops this far
;; below where the board last touched down (off the level, or into water, which
;; the jetboard can cross and a skateboard cannot), he is handed back to it.
(defconstant SKATE3_FALL_LIMIT (meters 30))
(define *skate3-bridge-ground-y* 0.0)
;; After a bail the engine puts the skater back at a spot it remembers from
;; earlier in the ride, and with nothing remembered yet, at its own origin. A
;; jump this far from the centre of the gathered world in one step is such a
;; respawn somewhere the engine has no ground: he is restarted at the last safe
;; spot instead.
(defconstant SKATE3_TELEPORT_DIST (meters 14))
;; Where the board last rolled with its wheels down. A bailed skater can come to
;; rest inside or under the level's collision, so Jak is put back here if he is
;; handed back to the game mid-bail.
(define *skate3-bridge-safe-pos* (new 'global 'vector))

(defun skate3-bridge-stick ((raw int) (invert symbol))
  "Byte stick axis around 128 to -1..1. The pad's vertical axes grow downward."
  (let ((value (fmax -1.0 (fmin 1.0 (/ (- (the float raw) 128.0) 127.0)))))
    (if invert (- value) value)))

(defun skate3-bridge-read-pad! ((io skate3-bridge-io) (pad cpad-info))
  "Translate the pad to the Xbox layout Skate 3 expects: cross, circle and
   square are its A, B and X, and L2 and R2 its triggers. Triangle is Skate 3's
   get-off-the-board button and is handled by the bridge itself (it takes Jak
   off the board), so it is not passed to the engine."
  (set! (-> io left-x) (skate3-bridge-stick (the-as int (-> pad leftx)) #f))
  (set! (-> io left-y) (skate3-bridge-stick (the-as int (-> pad lefty)) #t))
  (set! (-> io right-x) (skate3-bridge-stick (the-as int (-> pad rightx)) #f))
  (set! (-> io right-y) (skate3-bridge-stick (the-as int (-> pad righty)) #t))
  (let ((held (-> pad button0-abs 0))
        (buttons 0))
    (if (logtest? held (pad-buttons up)) (logior! buttons #x1))
    (if (logtest? held (pad-buttons down)) (logior! buttons #x2))
    (if (logtest? held (pad-buttons left)) (logior! buttons #x4))
    (if (logtest? held (pad-buttons right)) (logior! buttons #x8))
    (if (logtest? held (pad-buttons l1)) (logior! buttons #x100))
    (if (logtest? held (pad-buttons r1)) (logior! buttons #x200))
    (if (logtest? held (pad-buttons x)) (logior! buttons #x1000))
    (if (logtest? held (pad-buttons circle)) (logior! buttons #x2000))
    (if (logtest? held (pad-buttons square)) (logior! buttons #x4000))
    (set! (-> io buttons) (the-as uint buttons))
    (set! (-> io left-trigger) (if (logtest? held (pad-buttons l2)) 1.0 0.0))
    (set! (-> io right-trigger) (if (logtest? held (pad-buttons r2)) 1.0 0.0)))
  (none))

(defun skate3-bridge-clear-input! ((io skate3-bridge-io))
  (set! (-> io buttons) (the-as uint 0))
  (set! (-> io left-x) 0.0)
  (set! (-> io left-y) 0.0)
  (set! (-> io right-x) 0.0)
  (set! (-> io right-y) 0.0)
  (set! (-> io left-trigger) 0.0)
  (set! (-> io right-trigger) 0.0)
  (none))

(defun skate3-bridge-gather-world ((center vector))
  "Collect the solid collision in a square around center for the engine.
   Leaves it pending: an activate or a world commit puts it to use."
  (let ((io *skate3-bridge-io*)
        (cquery (new 'stack-no-clear 'collide-query))
        (half (* 0.5 (the float SKATE3_WORLD_CELLS) SKATE3_WORLD_CELL_SIZE)))
    (set! (-> io command) 3)
    (pc-skate3-bridge io)
    ;; the level itself, and the meshes of things Jak cannot pass through
    (set! (-> cquery collide-with) (collide-spec backgnd obstacle pusher special-obstacle obstacle-for-jak))
    (set! (-> cquery ignore-process0) *target*)
    (set! (-> cquery ignore-process1) #f)
    (set! *skate3-bridge-world-objects?* #f)
    (set! (-> cquery ignore-pat)
          (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
    (set! (-> cquery action-mask) (collide-action solid))
    (set! *skate3-bridge-world-overflows* 0)
    (dotimes (ix SKATE3_WORLD_CELLS)
      (dotimes (iz SKATE3_WORLD_CELLS)
        (let ((x0 (+ (- (-> center x) half) (* (the float ix) SKATE3_WORLD_CELL_SIZE)))
              (z0 (+ (- (-> center z) half) (* (the float iz) SKATE3_WORLD_CELL_SIZE))))
          (set-vector! (-> cquery bbox min) x0 (- (-> center y) SKATE3_WORLD_HALF_HEIGHT) z0 1.0)
          (set-vector! (-> cquery bbox max)
                       (+ x0 SKATE3_WORLD_CELL_SIZE)
                       (+ (-> center y) SKATE3_WORLD_HALF_HEIGHT)
                       (+ z0 SKATE3_WORLD_CELL_SIZE)
                       1.0))
        (fill-using-bounding-box *collide-cache* cquery)
        ;; the background counts as one primitive; anything more is an object
        (if (> (-> *collide-cache* num-prims) 1)
            (set! *skate3-bridge-world-objects?* #t))
        (when (> (-> *collide-cache* num-tris) 0)
          (if (>= (-> *collide-cache* num-tris) 461)
              (+! *skate3-bridge-world-overflows* 1))
          (set! (-> io world-tris) (the-as uint (-> *collide-cache* tris)))
          (set! (-> io world-count) (the-as uint (-> *collide-cache* num-tris)))
          (set! (-> io command) 4)
          (pc-skate3-bridge io))))
    (vector-copy! *skate3-bridge-world-center* center)
    (set! *skate3-bridge-world-time* (-> *display* base-clock frame-counter)))
  (none))

(defun skate3-bridge-postbind ((draw draw-control) (nodes cspace-array) (jc joint-control))
  "Runs after Jak's own joint animation: replace his bones with the skater's pose."
  (when (and *jak3-skate3-bridge-active* (> *skate3-rig-count* 0))
    (let ((count (min *skate3-rig-count* (-> nodes length)))
          (i SKATE3_RIG_FIRST_BONE))
      (while (< i count)
        (let ((bone (-> nodes data i bone)))
          (if bone
              (matrix-copy! (-> bone transform) (-> *skate3-rig-pose* i))))
        (+! i 1))))
  (none))

(defbehavior target-skate3-bridge-rig-pose target ()
  "Fetch the skater's pose for the engine's latest step, to be applied by the postbind."
  (let ((io *skate3-bridge-io*))
    (set! (-> io command) 7)
    (set! (-> io rig-pose) (the-as uint *skate3-rig-pose*))
    (set! (-> io rig-count) (the-as uint *skate3-rig-count*))
    (if (!= (pc-skate3-bridge io) 0)
        (set! *skate3-rig-count* 0)))
  (none))

(defbehavior target-skate3-bridge-rig-setup target ()
  "Describe Jak's skeleton to the engine so it can fit the skater's pose to it."
  (let* ((io *skate3-bridge-io*)
         (nodes (-> self node-list))
         (count (min SKATE3_RIG_MAX_BONES (-> nodes length))))
    (dotimes (i count)
      (let ((cs (-> nodes data i))
            (rb (-> *skate3-rig-bones* i)))
        (cond
          ((-> cs joint)
           (matrix-copy! (-> rb inv-bind) (-> cs joint bind-pose))
           (set! (-> rb name) (the-as string (-> cs joint name))))
          (else
           (matrix-identity! (-> rb inv-bind))
           (set! (-> rb name) (the-as string 0))))
        (set! (-> rb parent)
              (if (-> cs parent)
                  (/ (&- (the-as pointer (-> cs parent)) (the-as uint (-> nodes data 0))) 32)
                  -1))))
    (set! (-> io command) 6)
    (set! (-> io rig-bones) (the-as uint *skate3-rig-bones*))
    (set! (-> io rig-count) (the-as uint count))
    (cond
      ((= (pc-skate3-bridge io) 0)
       (set! *skate3-rig-count* count)
       (target-skate3-bridge-rig-pose)
       (set! (-> self skel postbind-function) skate3-bridge-postbind)
       ;; The board joint now carries a skateboard, which has no room for
       ;; Daxter: put him back on Jak's shoulder.
       (send-event (ppointer->process (-> self sidekick)) 'matrix 'normal))
      (else
       (set! *skate3-rig-count* 0))))
  (none))

(defun skate3-bridge-draw-hud ()
  "Skate 3's own trick names and scoring, as plain text."
  (let ((io *skate3-bridge-io*))
    (when (!= (-> io tricks) *skate3-hud-tricks*)
      (set! *skate3-hud-tricks* (the-as int (-> io tricks)))
      (set! *skate3-hud-trick-time* (-> *display* real-clock frame-counter)))
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf))
                                 (bucket-id debug-no-zbuf2))
      (dma-buffer-add-gs-set-flusha buf
                                    (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                                    (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1)))
      (when (and (> (-> io tricks) 0)
                 (< (- (-> *display* real-clock frame-counter) *skate3-hud-trick-time*) (seconds 2.5)))
        ;; between the normal and the large font, so long grind names still fit
        (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 256 350 0.0 (font-color yellow) (font-flags shadow kerning middle large))))
          (set! (-> font-ctx scale) 0.55)
          (draw-string-adv *skate3-trick-name* buf font-ctx)))
      (when (nonzero? (-> io sequence-active))
        (clear *skate3-hud-string*)
        (format *skate3-hud-string* "~D x~D" (the int (-> io sequence)) (the int (-> io multiplier)))
        (draw-string-xy *skate3-hud-string* buf 256 378 (font-color white) (font-flags shadow kerning middle)))
      (when (> (-> io total) 0.0)
        (clear *skate3-hud-string*)
        (format *skate3-hud-string* "~D" (the int (-> io total)))
        (draw-string-xy *skate3-hud-string* buf 500 20 (font-color white) (font-flags shadow kerning right)))))
  (none))

(defbehavior target-skate3-bridge-release target ()
  "Give Jak back to the game: stop following the engine and stop posing him."
  (when *jak3-skate3-bridge-active*
    ;; Engine states: 100s riding, 200s in the air, 300 bailed, 500s off the board.
    (when (>= (-> *skate3-bridge-io* state) 300)
      (move-to-point! (-> self control) *skate3-bridge-safe-pos*)
      (vector-reset! (-> self control transv)))
    (set! (-> *skate3-bridge-io* command) 8)
    (pc-skate3-bridge *skate3-bridge-io*)
    ;; On the jetboard Daxter rides the board joint.
    (send-event (ppointer->process (-> self sidekick)) 'matrix 'board))
  (set! *jak3-skate3-bridge-active* #f)
  (set! *skate3-rig-count* 0)
  (if (= (-> self skel postbind-function) skate3-bridge-postbind)
      (set! (-> self skel postbind-function) #f))
  (none))

(defbehavior target-skate3-bridge-activate target ()
  "Start the engine under Jak. Blocks for several seconds the first time."
  (skate3-bridge-gather-world (-> self control trans))
  (let ((io *skate3-bridge-io*))
    (set! (-> io command) 1)
    (vector-copy! (-> io position) (-> self control trans))
    (vector-z-quaternion! (-> io forward) (-> self control quat))
    ;; Jak is drawn larger than his model; the scale is in his bone matrices.
    (set! (-> io unit-scale) (vector-length (-> self node-list data SKATE3_RIG_FIRST_BONE bone transform rvec)))
    (set! (-> io world-scale) *jak3-skate3-bridge-world-scale*)
    (set! (-> io trick-name) *skate3-trick-name*)
    (skate3-bridge-clear-input! io)
    (set! *skate3-rig-count* 0)
    (set! *jak3-skate3-bridge-active* (= (pc-skate3-bridge io) 0))
    (set! *skate3-bridge-ground-y* (-> self control trans y))
    (set! *skate3-bridge-off-board-frames* 0)
    (vector-copy! *skate3-bridge-safe-pos* (-> self control trans))
    (when *jak3-skate3-bridge-active*
      (target-skate3-bridge-rig-setup)
      ;; The jetboard's hover, wind and engine loops are kept alive by its own
      ;; update, which no longer runs; it starts them again when it resumes.
      (sound-stop (-> self board wind-sound-id))
      (sound-stop (-> self board engine-sound-id))
      (sound-stop (-> self board bank-sound-id))
      (sound-stop (-> self board ride-sound-id))
      (sound-stop (-> self board eco-sound-id))
      (sound-stop (-> self board charge-sound-id)))
    ;; A failed start turns the bridge off so it is not retried every frame.
    (when (not *jak3-skate3-bridge-active*)
      (format 0 "[skate3] bridge off: the engine did not start (status ~D)~%" (-> io status))
      (set! *jak3-skate3-bridge-enabled* #f)))
  *jak3-skate3-bridge-active*)

(defbehavior target-skate3-bridge-step target ()
  "Advance the engine and put Jak where its board is. #f if the engine failed."
  (let ((io *skate3-bridge-io*))
    (set! (-> io command) 0)
    (set! (-> io dt) (if *jak3-skate3-bridge-scripted-input* 0.0 (seconds-per-frame)))
    (if (not *jak3-skate3-bridge-scripted-input*)
        (skate3-bridge-read-pad! io (-> self control cpad)))
    (cond
      ((!= (pc-skate3-bridge io) 0)
       (format 0 "[skate3] bridge off: the engine step failed (status ~D)~%" (-> io status))
       (target-skate3-bridge-release)
       (set! *jak3-skate3-bridge-enabled* #f)
       #f)
      ((begin
         (if (> (-> io wheels) 0)
             (set! *skate3-bridge-ground-y* (-> io position y)))
         (when (and (< (-> io state) 200) (>= (-> io wheels) 3))
           (vector-copy! *skate3-bridge-safe-pos* (-> io position))
           ;; Jak stands a little above where the board's wheels touch.
           (+! (-> *skate3-bridge-safe-pos* y) (meters 0.3)))
         (< (-> io position y) (- *skate3-bridge-ground-y* SKATE3_FALL_LIMIT)))
       ;; Fallen out of the world the engine knows (it was standing on something
       ;; the engine could not see, or went off the level). Put Jak back where
       ;; the board last stood and give him the jetboard.
       (format 0 "[skate3] bridge off: the skater fell from ~m to ~m, out of the world the engine knows~%"
               *skate3-bridge-ground-y* (-> io position y))
       (move-to-point! (-> self control) *skate3-bridge-safe-pos*)
       (vector-reset! (-> self control transv))
       (target-skate3-bridge-release)
       (set! *jak3-skate3-bridge-enabled* #f)
       #f)
      (#t
       (let ((dx (- (-> io position x) (-> *skate3-bridge-world-center* x)))
             (dz (- (-> io position z) (-> *skate3-bridge-world-center* z))))
         (when (> (+ (* dx dx) (* dz dz)) (* SKATE3_TELEPORT_DIST SKATE3_TELEPORT_DIST))
           (move-to-point! (-> self control) *skate3-bridge-safe-pos*)
           (target-skate3-bridge-activate)))
       (move-to-point! (-> self control) (-> io position))
       (vector-copy! (-> self control transv) (-> io velocity))
       (forward-up-nopitch->quaternion (-> self control quat) (-> io forward) *up-vector*)
       (quaternion-copy! (-> self control quat-for-control) (-> self control quat))
       (quaternion-copy! (-> self control dir-targ) (-> self control quat))
       ;; A skateboard sits on the ground; the jetboard is drawn hovering.
       (set! (-> self control draw-offset y) 0.0)
       (if (> *skate3-rig-count* 0)
           (target-skate3-bridge-rig-pose))
       ;; Keep the engine's world centred on Jak. The engine builds it in the
       ;; background and swaps it in on a later step.
       (let ((dx (- (-> io position x) (-> *skate3-bridge-world-center* x)))
             (dz (- (-> io position z) (-> *skate3-bridge-world-center* z)))
             (dy (- (-> io position y) (-> *skate3-bridge-world-center* y))))
         (when (or (> (+ (* dx dx) (* dz dz)) (* SKATE3_WORLD_REFRESH_DIST SKATE3_WORLD_REFRESH_DIST))
                   (> (fabs dy) (* 0.5 SKATE3_WORLD_HALF_HEIGHT))
                   (and *skate3-bridge-world-objects?*
                        (> (- (-> *display* base-clock frame-counter) *skate3-bridge-world-time*) (seconds 0.75))))
           (skate3-bridge-gather-world (-> io position))
           (set! (-> io command) 5)
           (pc-skate3-bridge io)))
       #t))))

(defbehavior target-skate3-bridge-on-foot target ()
  "Called from Jak's normal post. If gk was started with the bridge configured,
   the jetboard is a skateboard from the start, and Jak has it."
  (when (= *jak3-skate3-bridge-configured* 'unknown)
    (set! (-> *skate3-bridge-io* command) 9)
    (set! *jak3-skate3-bridge-configured* (= (pc-skate3-bridge *skate3-bridge-io*) 0))
    (if *jak3-skate3-bridge-configured*
        (set! *jak3-skate3-bridge-enabled* #t)))
  (when *jak3-skate3-bridge-configured*
    (logior! (-> *game-info* features) (game-feature board))
    (logior! (-> *game-info* debug-features) (game-feature board)))
  (none))

(defbehavior target-skate3-bridge-post target ()
  "The jetboard's post while the bridge drives it. #f when the bridge is not
   driving this frame and the normal jetboard post must run instead."
  ;; On the board, holding the right stick in and clicking the left one switches
  ;; between skateboard and jetboard. (The other order is a debug-mode camera
  ;; shortcut.)
  (let ((pad (-> self control cpad number)))
    (when (and (not *jak3-skate3-bridge-scripted-input*)
               (cpad-pressed? pad l3)
               (cpad-hold? pad r3))
      (set! *jak3-skate3-bridge-enabled* (not *jak3-skate3-bridge-enabled*))
      (set! *jak3-skate3-bridge-in-water* #f)
      (cpad-clear! pad l3)))
  ;; Out of the water for a second: back to the skateboard.
  (when *jak3-skate3-bridge-in-water*
    (if (logtest? (water-flag touch-water) (-> self water flags))
        (set! *skate3-bridge-dry-time* (current-time)))
    (when (time-elapsed? *skate3-bridge-dry-time* (seconds 1))
      (set! *jak3-skate3-bridge-in-water* #f)
      (set! *jak3-skate3-bridge-enabled* #t)))
  (cond
    ((or (not *jak3-skate3-bridge-enabled*)
         ;; a cutscene or script has taken hold of Jak, or he is dead: the game
         ;; moves him now. The bridge picks up again by itself afterwards.
         (focus-test? self grabbed dead))
     (if *jak3-skate3-bridge-active*
         (target-skate3-bridge-release))
     #f)
    ((not *jak3-skate3-bridge-active*)
     ;; The engine starts from Jak's current pose, so this frame is still his.
     (target-skate3-bridge-activate)
     #f)
    ((begin
       (when *skate3-bridge-restart?*
         (set! *skate3-bridge-restart?* #f)
         (move-to-point! (-> self control) *skate3-bridge-restart-pos*)
         (forward-up-nopitch->quaternion (-> self control quat) *skate3-bridge-restart-dir* *up-vector*)
         (when (and (target-skate3-bridge-activate) (> *skate3-bridge-restart-speed* 0.0))
           (vector-float*! (-> *skate3-bridge-io* velocity) *skate3-bridge-restart-dir* *skate3-bridge-restart-speed*)
           (set! (-> *skate3-bridge-io* command) 11)
           (pc-skate3-bridge *skate3-bridge-io*)))
       (and *jak3-skate3-bridge-active* (target-skate3-bridge-step)))
     ;; The jetboard's get-on state waits on the jetboard's own movement, which
     ;; is not running, and would otherwise never finish.
     (if (and (= (-> self state name) 'target-board-get-on)
              (time-elapsed? (-> self state-time) (seconds 0.5)))
         (go target-board-stance))
     ;; The jetboard's states put Daxter on the board joint whenever they like
     ;; (getting on, landing a trick). That joint now carries a skateboard with
     ;; no room for him, so keep him on Jak's shoulder.
     (let ((sidekick (ppointer->process (-> self sidekick))))
       (if (and sidekick
                (= (-> (the-as process-drawable sidekick) node-list data 0 param1)
                   (-> self node-list data 37)))
           (send-event sidekick 'matrix 'normal)))
     ;; Jak's own post without his movement: joints (the skater's pose is put
     ;; on them by the postbind), touching, shadow and powerups.
     (target-no-move-post)
     (target-board-joint-points)
     ;; The engine only knows the solid bottom, so a skateboard would sink
     ;; through water. Where the game knows of water here and the board has
     ;; reached its surface, or Jak is already in deep, hand over to the
     ;; jetboard, which rides on it, until he is out again.
     (when (or (and (logtest? (water-flag active) (-> self water flags))
                    (< (-> self control trans y) (+ (-> self water height) (meters 0.2))))
               (and (logtest? (water-flag touch-water) (-> self water flags))
                    (logtest? (water-flag swimming under-water) (-> self water flags))))
       (when (< (-> self control trans y) (-> self water height))
         ;; already below the surface: back up to it
         (let ((surface (new 'stack-no-clear 'vector)))
           (vector-copy! surface (-> self control trans))
           (set! (-> surface y) (+ (-> self water height) (meters 0.2)))
           (move-to-point! (-> self control) surface)))
       (set! *jak3-skate3-bridge-in-water* #t)
       (set! *skate3-bridge-dry-time* (current-time))
       (set! *jak3-skate3-bridge-enabled* #f))
     (if *jak3-skate3-bridge-hud*
         (skate3-bridge-draw-hud))
     ;; The engine has its own walking mode (states in the 500s), which it can
     ;; fall into by itself. Jak has his own legs: he gets off instead.
     (if (>= (-> *skate3-bridge-io* state) 500)
         (+! *skate3-bridge-off-board-frames* 1)
         (set! *skate3-bridge-off-board-frames* 0))
     ;; Triangle gets off the board, as in Skate 3 (R2 is a grab here).
     (if (and (or (> *skate3-bridge-off-board-frames* 30)
                  (and (not *jak3-skate3-bridge-scripted-input*)
                       (cpad-pressed? (-> self control cpad number) triangle)))
              (not (focus-test? self dead grabbed))
              (not *pause-lock*))
         (go target-board-get-off (process->handle self) #f))
     #t)
    (else
     #f)))

)
